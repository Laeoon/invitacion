---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import 'aos/dist/aos.css';
import { EVENT_CONFIG } from '../config/event';

interface Props {
  title?: string;
}

const { title = `Mis XV Años — ${EVENT_CONFIG.celebrantName}` } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`Invitación oficial a los XV años de ${EVENT_CONFIG.celebrantName} — ${EVENT_CONFIG.dateLabel}`}
    />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased selection:bg-[#9b1b30]/20 selection:text-[#4a0a13]">
    <div
      class="pointer-events-none fixed inset-0 -z-10 opacity-90"
      style="background: radial-gradient(circle at 15% 12%, rgba(155, 27, 48, 0.08), transparent 42%), radial-gradient(circle at 85% 22%, rgba(200, 157, 84, 0.14), transparent 45%), radial-gradient(circle at 50% 85%, rgba(122, 19, 32, 0.07), transparent 50%);"
    >
    </div>

    <slot />

    <script>
      import AOS from 'aos';

      function initAos() {
        AOS.init({
          duration: 850,
          easing: 'ease-out-cubic',
          once: true,
          offset: 50,
        });
      }

      document.addEventListener('astro:page-load', initAos);
    </script>
  </body>
</html>
