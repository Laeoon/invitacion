---
import Layout from '../layouts/Layout.astro';
import AnimatedBackground from '../components/AnimatedBackground.astro';
import PhotoAlbum from '../components/PhotoAlbum.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Toast from '../components/Toast.astro';
import { EVENT_CONFIG } from '../config/event';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title={`Álbum Polaroid — ${EVENT_CONFIG.celebrantName}`}>
  <AnimatedBackground />

  <nav class="px-5 pt-6">
    <div class="mx-auto flex max-w-5xl items-center justify-between">
      <a
        href={baseUrl}
        class="inline-flex items-center gap-2 rounded-full border border-[#c89d54]/50 bg-[#faf5ec]/85 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#4a0a13] shadow-sm backdrop-blur-md transition hover:bg-[#f3e8d2]"
      >
        ← Volver a la Invitación
      </a>

      <span class="font-serif text-lg font-semibold text-[#7a1320]">
        {EVENT_CONFIG.initials} · {EVENT_CONFIG.editionLabel}
      </span>
    </div>
  </nav>

  <main>
    {
      EVENT_CONFIG.albumEnabled ? (
        <PhotoAlbum />
      ) : (
        <section class="px-5 py-16">
          <div class="royal-glass mx-auto max-w-lg rounded-3xl p-8 text-center sm:p-10">
            <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#9b1b30]">
              Próximamente
            </p>
            <h1 class="mt-2 font-serif text-3xl font-semibold text-[#4a0a13] sm:text-4xl">
              Álbum Polaroid
            </h1>
            <p class="mt-4 text-sm leading-relaxed text-[#2b181b]/80 sm:text-base">
              El álbum se habilitará el día de la celebración ({EVENT_CONFIG.dateLabel}) para que puedas subir y descargar tus Polaroids de la noche.
            </p>
            <div class="mt-6">
              <a
                href={baseUrl}
                class="inline-flex items-center justify-center rounded-xl bg-[#7a1320] px-6 py-3 text-xs font-semibold uppercase tracking-widest text-[#faf5ec] transition hover:bg-[#9b1b30]"
              >
                Volver a la Invitación
              </a>
            </div>
          </div>
        </section>
      )
    }
  </main>

  <footer class="border-t border-[#c89d54]/25 py-8 text-center text-xs tracking-widest text-[#4a0a13]/70 uppercase">
    {EVENT_CONFIG.editionLabel} · {EVENT_CONFIG.celebrantName} · {EVENT_CONFIG.dateLabel}
  </footer>

  <MusicPlayer />
  <Toast />
</Layout>
