---
import { EVENT_CONFIG } from '../config/event';
import RoseOrnament from './RoseOrnament.astro';
---

<section id="coordenadas" class="px-5 py-12 sm:py-16">
  <div class="mx-auto max-w-4xl">
    <div class="text-center" data-aos="fade-up">
      <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#9b1b30]">
        Dónde y Cuándo
      </p>
      <h2 class="mt-2 font-serif text-3xl font-semibold text-[#4a0a13] sm:text-5xl">
        Coordenadas del Evento
      </h2>
      <RoseOrnament compact />
    </div>

    <div
      class:list={[
        'mt-8 grid gap-6',
        EVENT_CONFIG.locations.length === 1 ? 'mx-auto max-w-xl' : 'md:grid-cols-2',
      ]}
    >
      {
        EVENT_CONFIG.locations.map((loc, index) => (
          <article
            class="royal-glass flex flex-col justify-between rounded-3xl p-6 text-center sm:p-8"
            data-aos="fade-up"
            data-aos-delay={index * 120}
          >
            <div>
              <span class="inline-block rounded-full bg-[#7a1320]/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-[#7a1320]">
                {loc.title}
              </span>

              <p class="mt-4 font-serif text-2xl font-semibold text-[#4a0a13]">
                {loc.place}
              </p>

              <p class="mt-2 text-sm font-semibold text-[#9b1b30]">
                Hora: {loc.time}
              </p>

              <p class="mt-2 text-sm text-[#2b181b]/75">
                {loc.address}
              </p>
            </div>

            <div class="mt-6 grid grid-cols-2 gap-3">
              <a
                href={loc.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#c89d54]/50 bg-[#faf5ec]/90 px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-[#4a0a13] transition hover:border-[#9b1b30] hover:bg-[#f3e8d2]"
              >
                <svg class="h-4 w-4 text-[#9b1b30]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
                </svg>
                Google Maps
              </a>

              <a
                href={loc.wazeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#7a1320] px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-[#faf5ec] transition hover:bg-[#9b1b30]"
              >
                <svg class="h-4 w-4 text-[#e5c98b]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 3C7.03 3 3 6.58 3 11c0 2.09.91 3.99 2.4 5.41-.22.97-.72 1.88-1.35 2.59 1.38-.03 2.75-.46 3.85-1.15C9.15 18.58 10.54 19 12 19c4.97 0 9-3.58 9-8s-4.03-8-9-8Zm-2.5 7.5a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Zm5 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z" />
                </svg>
                Waze
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
