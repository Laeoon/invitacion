---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['flex items-center justify-center gap-3', compact ? 'my-4' : 'my-8']}>
  <span class="gold-divider w-16 sm:w-24"></span>
  <svg
    class="h-6 w-6 text-[#9b1b30] drop-shadow-sm"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M16 4c2.8 2.8 5.5 5.8 5.5 9.6A5.5 5.5 0 1 1 10.5 13.6C10.5 9.8 13.2 6.8 16 4Z"
      fill="currentColor"
    />
    <path
      d="M16 9c1.8 1.8 3.2 3.6 3.2 5.6a3.2 3.2 0 1 1-6.4 0C12.8 12.6 14.2 10.8 16 9Z"
      fill="#6d1322"
    />
    <path
      d="M16 19.5v8M16 23.5c-2.6-.2-4.8-1.4-6-3.2M16 23.5c2.6-.2 4.8-1.4 6-3.2"
      stroke="#c89d54"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  </svg>
  <span class="gold-divider w-16 sm:w-24"></span>
</div>
