---
import { EVENT_CONFIG } from '../config/event';
import RoseOrnament from './RoseOrnament.astro';
---

<section id="itinerario" class="px-5 py-12 sm:py-16">
  <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
    <div class="royal-glass rounded-3xl p-6 sm:p-8" data-aos="fade-up">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.26em] text-[#9b1b30]">
        La Noche Real
      </p>
      <h2 class="mt-2 text-center font-serif text-3xl font-semibold text-[#4a0a13] sm:text-4xl">
        Itinerario
      </h2>
      <RoseOrnament compact />

      <ol class="relative mt-6 space-y-6 border-l border-[#c89d54]/55 pl-6">
        {
          EVENT_CONFIG.itinerary.map((item) => (
            <li class="relative">
              <span class="absolute -left-[31px] top-1.5 flex h-3.5 w-3.5 items-center justify-center rounded-full border-2 border-[#c89d54] bg-[#7a1320]" />
              <p class="text-xs font-semibold uppercase tracking-widest text-[#9b1b30]">
                {item.time}
              </p>
              <h3 class="mt-0.5 font-serif text-xl font-semibold text-[#4a0a13]">
                {item.title}
              </h3>
              <p class="text-sm text-[#2b181b]/75">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="royal-glass flex flex-col justify-between rounded-3xl p-6 text-center sm:p-8" data-aos="fade-up" data-aos-delay="120">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#9b1b30]">
          Sugerencia de Vestimenta
        </p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-[#4a0a13] sm:text-4xl">
          Dress Code
        </h2>
        <RoseOrnament compact />

        <p class="mt-2 font-serif text-2xl font-semibold text-[#7a1320]">
          {EVENT_CONFIG.dressCode.label}
        </p>
        <p class="mt-2 text-sm text-[#2b181b]/75">
          {EVENT_CONFIG.dressCode.note}
        </p>
      </div>

      <div class="mt-6 space-y-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#4a0a13]/80">
            Recomendados para Invitados
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-4">
            {
              EVENT_CONFIG.dressCode.suggestedColors.map((swatch) => (
                <div class="flex flex-col items-center gap-1.5">
                  <span
                    class="h-9 w-9 rounded-full border border-[#c89d54]/60 shadow-sm"
                    style={`background-color: ${swatch.hex};`}
                    title={swatch.name}
                  />
                  <span class="text-[11px] font-medium text-[#2b181b]/75">{swatch.name}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="gold-divider"></div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#9b1b30]">
            Reservados de la Cumpleañera
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-5">
            {
              EVENT_CONFIG.dressCode.reservedColors.map((swatch) => (
                <div class="flex flex-col items-center gap-1.5">
                  <span
                    class="relative h-9 w-9 rounded-full border border-[#c89d54]/60 shadow-sm"
                    style={`background-color: ${swatch.hex};`}
                    title={swatch.name}
                  />
                  <span class="text-[11px] font-medium text-[#2b181b]/75">{swatch.name}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
