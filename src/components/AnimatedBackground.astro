<canvas
  id="royal-particles-canvas"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
></canvas>

<script>
  const canvas = document.getElementById('royal-particles-canvas') as HTMLCanvasElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReduced) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);

      interface Particle {
        x: number;
        y: number;
        size: number;
        speedY: number;
        speedX: number;
        opacity: number;
        rotation: number;
        rotSpeed: number;
        kind: 'sparkle' | 'petal';
      }

      const count = width < 640 ? 24 : 40;
      const particles: Particle[] = Array.from({ length: count }, (_, idx) => ({
        x: Math.random() * width,
        y: Math.random() * height,
        size: idx % 4 === 0 ? 5 + Math.random() * 5 : 1.5 + Math.random() * 2.5,
        speedY: idx % 4 === 0 ? 0.35 + Math.random() * 0.45 : -(0.2 + Math.random() * 0.4),
        speedX: (Math.random() - 0.5) * 0.45,
        opacity: 0.25 + Math.random() * 0.45,
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.02,
        kind: idx % 4 === 0 ? 'petal' : 'sparkle',
      }));

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      function draw() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);

        for (const p of particles) {
          p.x += p.speedX + Math.sin(p.y * 0.01) * 0.15;
          p.y += p.speedY;
          p.rotation += p.rotSpeed;

          if (p.kind === 'petal' && p.y > height + 20) {
            p.y = -20;
            p.x = Math.random() * width;
          } else if (p.kind === 'sparkle' && p.y < -15) {
            p.y = height + 15;
            p.x = Math.random() * width;
          }

          if (p.x > width + 20) p.x = -20;
          if (p.x < -20) p.x = width + 20;

          ctx.save();
          ctx.globalAlpha = p.opacity;
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rotation);

          if (p.kind === 'petal') {
            ctx.fillStyle = '#9b1b30';
            ctx.beginPath();
            ctx.ellipse(0, 0, p.size, p.size * 0.62, 0, 0, Math.PI * 2);
            ctx.fill();
          } else {
            ctx.fillStyle = '#d4af37';
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }

          ctx.restore();
        }

        window.requestAnimationFrame(draw);
      }

      draw();
    }
  }
</script>
